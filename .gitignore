# Electron: 299 MB of Chromium, reinstallable with npm ci
node_modules/

# the Deskflow .deb: a 1.4 MB binary, downloadable from GitHub Releases
*.deb

__pycache__/
*.pyc
*.log

# Rust: `target/` in ANY crate, not one per name.
#
# The per-name list went stale: `oxdesk-stream`, `hidpp` and `winput` were
# born later and were not on it, so 3,893 build files got into the repo
# and every `cargo build` started dirtying the tree -- the deploy itself
# stamped the binaries as `-sujo` (dirty) because of it. A pattern without
# a leading slash matches at any level.
target/

# Output of scripts/build-binaries.sh
dist/

# Signing keys live in ~/.config/oxdesk/signing, never here.
*.pem
*.pfx
*.cer

# macOS
.DS_Store

# Secrets
.env
.env.*
*.key
*.p12

# Personal Claude Code config
.claude/settings.local.json
