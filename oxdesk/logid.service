[Unit]
Description=oxdesk - control plane da infra de duas maquinas na LAN
Documentation=file:///home/user/dev/oxdesk/specs/001-control-plane.md

[Service]
Type=simple
# `process` e nao o padrao `control-group`: reiniciar o daemon NAO pode
# derrubar o `oxdesk-kvm`, que pode estar segurando o teclado de
# alguem que esta trabalhando na outra maquina. Com o padrao, cada
# deploy arrancava o input de volta no meio de uma frase.
KillMode=process
ExecStart=%h/.local/bin/oxdesk
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
