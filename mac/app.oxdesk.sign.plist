<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signs the screen host with the local identity.

  A LaunchAgent for the SAME reason as the host: `codesign` needs the
  LOGIN keychain unlocked, and in an SSH session it is locked -- the call
  fails with `errSecInternalComponent`, which says nothing about the
  keychain. In the graphical session the keychain is already open.

  Third time the same boundary showed up today: Screen Recording,
  Accessibility and now the keychain. What depends on the user's session
  is not born over SSH.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>app.oxdesk.sign</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/user/.local/bin/sign.sh</string>
    <string>/Users/user/.local/bin/oxdesk-host</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/Users/user/.local/state/sign.log</string>
  <key>StandardErrorPath</key><string>/Users/user/.local/state/sign.log</string>
</dict>
</plist>
